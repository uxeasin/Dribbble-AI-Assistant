# Dribbble AI Assistant — build-time configuration.
# Copy to `.env.local` and adjust. Never commit real secrets.

# Default AI provider id (currently: "openai"). Users can change it in Settings.
VITE_AI_PROVIDER=openai

# Default model used for analysis and content generation. Must support image input.
VITE_AI_MODEL=gpt-4o-mini

# Base URL of an OpenAI-compatible API. Other hosts require granting an extra
# host permission from the Settings screen.
VITE_AI_BASE_URL=https://api.openai.com/v1

# DEVELOPMENT ONLY. Honoured only by `npm run dev` (mode=development) builds so
# you don't have to paste a key after every reload. Production builds ignore it,
# so a key can never end up in a distributable bundle. End users enter their key
# in the extension's Settings screen (stored in chrome.storage.local, never synced).
VITE_DEV_OPENAI_API_KEY=
